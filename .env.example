# EduGenie: Google Gemini Powered Learning Assistant
# ----------------------------------------------------

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Recommended: gemini-1.5-pro or gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-pro

# Explanation Module - Local Model Settings
# When ENABLE_LOCAL_MODEL is true and torch/transformers are installed,
# EduGenie will use LaMini-Flan-T5-783M locally for concept explanation.
# Otherwise, it automatically uses Gemini for high-speed concept explanation.
ENABLE_LOCAL_MODEL=False
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M

# Server Host & Port
APP_HOST=127.0.0.1
APP_PORT=8000
